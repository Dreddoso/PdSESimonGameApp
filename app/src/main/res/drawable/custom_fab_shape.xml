<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Colore di sfondo -->
    <solid android:color="#FF5722" />

    <!-- Angoli arrotondati -->
    <corners android:radius="12dp" />

    <!-- Bordo -->
    <stroke
        android:width="2dp"
        android:color="#FFF33F" />

    <!-- Padding interno -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>